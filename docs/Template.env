# =========================================================================
# Hardware Medido do Host
SYSTEM_TOTAL_CPUS=""
SYSTEM_TOTAL_RAM_MB=""
SYSTEM_TOTAL_DISK_GB=""

# Matriz Dinâmica de Limites de CPU (Docker)
CPU_POSTIZ="2.0"
CPU_CHATWOOT="1.0"
CPU_LITELLM="1.0"
CPU_OPENWEBUI="1.0"
CPU_N8N="1.0"
CPU_EVOLUTION="1.0"
