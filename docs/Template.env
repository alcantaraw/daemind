OPENWEBUI_SECRET_KEY=""
CHATWOOT_SECRET_KEY=""
POSTIZ_JWT_SECRET=""

# =========================================================================
# URLS DERIVADAS E ENDPOINTS INTERNOS DE MICROSSERVIÇOS
