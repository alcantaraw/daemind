# =========================================================================
# SRE SSOT: TEMPLATE CANÔNICO DE VARIÁVEIS DE AMBIENTE (.env)
# =========================================================================
# Este arquivo documenta a totalidade das variáveis consumidas e geradas
# pelo Wizard (preinstall.sh) e pelo Orquestrador de Runtime (install.sh).

# =========================================================================
# METRICS & ELEVAÇÃO DE AMBIENTE (HERANÇA PREINSTALL)
# =========================================================================
PREINSTALL_START_TS=""
PREINSTALL_PAUSE_SEC="0"

# =========================================================================
# CONFIGURAÇÃO DE DIRETÓRIOS E ESCOPO DO PROJETO
# =========================================================================
PROJETO_DIR="/opt/daemind"
PREFIXO_CONTAINER="loja"

# =========================================================================
# IDENTIDADE DO CLIENTE & TENANT SCHEMAS
# =========================================================================
CLIENTE_NOME="Joao"
CLIENTE_SOBRENOME="Silva"
TS_EMAIL="contato@loja.com"

# =========================================================================
# TOPOLOGIA DE BORDA (ROTEAMENTO SRE & DOMÍNIOS)
# =========================================================================
USE_TAILSCALE="true"
CUSTOM_DOMAIN=""
CUSTOM_EVO_DOMAIN=""
CADDY_PROTOCOL="https"

# =========================================================================
# REDE PRIVADA E PERÍMETRO (TAILSCALE OAUTH)
# =========================================================================
TS_OAUTH_ID="client-xxxxxxxxxxxxxxxxxx"
TS_OAUTH_SECRET="tskey-client-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# =========================================================================
# BANCO DE DADOS CORE (POSTGRESQL 16 / PGBOUNCER / REDIS)
# =========================================================================
DB_USER="admin_db"
DB_PASSWORD="MudeEssaSenha123!"
DB_NAME="loja_db"

# =========================================================================
# APIS DE TERCEIROS E INTELIGÊNCIA ARTIFICIAL (GATEWAY MÚLTIPLO)
# =========================================================================
# Integrações de E-commerce (Desativado momentaneamente)
LOJA_API_KEY=""
LOJA_APP_KEY=""

# System Prompt Canônico
IA_SYSTEM_PROMPT="Voce eh um assistente de IA focado em recuperacao de vendas, conversao de boletos e pix para e-commerce."

# Provedor Ativo Resolvido Dinamicamente
ACTIVE_AI_PROVIDER="openrouter"

# Chaves de Provedores de IA (OpenRouter e Gemini Free)
FREE_GEMINI="0"
GEMINI_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
DEEPSEEK_API_KEY=""
OPENROUTER_API_KEY="sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Master Key do LiteLLM Proxy
LITELLM_MASTER_KEY="sk-admin-MudeEssaSenha123!"

# =========================================================================
# MAPEAMENTO DE PORTAS DO HOST (INGRESS PORTS)
# =========================================================================
HOST_CADDY_PORT="80"
HOST_NOCODB_PORT="18080"
HOST_EVO_PORT="18081"
PROXY_PORT="80"
EVO_PORT="18081"
NOCO_PORT="18080"

# =========================================================================
# MAPEAMENTO ESTÁTICO DE REDE (SSOT CIDR)
# =========================================================================
IP_NETWORK_SUBNET="172.25.0.0/24"
IP_NETWORK_GATEWAY="172.25.0.1"
IP_REDIS="172.25.0.2"
