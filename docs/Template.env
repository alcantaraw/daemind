RES_WAF="64M"

# Parametrização Interna de Processos e Engines
NODE_HEAP_DEFAULT="768"
NODE_HEAP_POSTIZ="2048"
POSTGRES_SHARED_BUFFERS="256MB"
POSTGRES_WORK_MEM="8MB"
POSTGRES_MAINTENANCE_WORK_MEM="64MB"
POSTGRES_MAX_PARALLEL_WORKERS="2"
REDIS_MAXMEMORY="200mb"
LITELLM_NUM_WORKERS="1"
CHATWOOT_WEB_CONCURRENCY="2"
CHATWOOT_SIDEKIQ_CONCURRENCY="10"
MINIO_API_REQUESTS_MAX="1500"

# Compatibilidade de Caddy e Cache Legacy
CACHE_CACHE_INLINE="true"
CACHE_PROVIDER="local"
CACHE_REDIS_ENABLED="false"
CADDY_CPU_LIMIT="0.5"
CADDY_MEM_LIMIT="256M"

# =========================================================================
# SEGURANÇA E CUSTÓDIA DE CHAVES GPG (BACKUP CRIPTOGRAFADO)
