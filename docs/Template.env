# =========================================================================
# SRE SSOT: TEMPLATE CANÔNICO DE VARIÁVEIS DE AMBIENTE (.env)
# =========================================================================
# Este arquivo documenta a totalidade das variáveis consumidas e geradas
# pelo Wizard (preinstall.sh) e pelo Orquestrador de Runtime (install.sh).

# =========================================================================
# METRICS & ELEVAÇÃO DE AMBIENTE (HERANÇA PREINSTALL)
# =========================================================================
PREINSTALL_START_TS=""
PREINSTALL_PAUSE_SEC="0"

# =========================================================================
# CONFIGURAÇÃO DE DIRETÓRIOS E ESCOPO DO PROJETO
# =========================================================================
PROJETO_DIR="/opt/daemind"
PREFIXO_CONTAINER="loja"

# =========================================================================
# IDENTIDADE DO CLIENTE & TENANT SCHEMAS
# =========================================================================
CLIENTE_NOME="Joao"
CLIENTE_SOBRENOME="Silva"
TS_EMAIL="contato@loja.com"

# =========================================================================
# SELEÇÃO DE MÓDULOS OPCIONAIS (SRE FINOPS - DESACOPLAMENTO)
# =========================================================================
# Núcleo Core (Imutável): Postgres 17, PgBouncer, Redis 8, Caddy WAF e LiteLLM
# Módulos Opcionais (s/n):
USE_N8N="s"
USE_OPENWEBUI="s"
USE_CHATWOOT="s"
USE_EVOLUTION="s"
USE_POSTIZ="s"
USE_NOCODB="s"
USE_S3MINIO="s"
USE_METABASE="s"
USE_OLLAMA="s"
USE_DOCLING="s"
USE_LISTMONK="s"
USE_UMAMI="s"
USE_SHLINK="s"

# =========================================================================
# PARADIGMA E CONFIGURAÇÕES DE ARMAZENAMENTO (STORAGE_MODE & S3)
# =========================================================================
# Opções: local | s3minio | s3_external
STORAGE_MODE="local"
S3_ENDPOINT_EXT=""
S3_REGION_EXT="us-east-1"
S3_ACCESS_KEY_EXT=""
S3_SECRET_KEY_EXT=""
S3_CHATWOOT_BUCKET_EXT="chatwoot-storage"
S3_POSTIZ_BUCKET_EXT="postiz-storage"

# =========================================================================
# TOPOLOGIA DE BORDA (ROTEAMENTO SRE & DOMÍNIOS)
