CPU_POOLER="0.2"

# Matriz Dinâmica de Limites de Memória RAM (Docker)
MEM_POSTIZ="4096M"
MEM_LITELLM="2048M"
MEM_CHATWOOT="2048M"
MEM_OPENWEBUI="1024M"
MEM_N8N="1024M"
MEM_EVOLUTION="1024M"
MEM_DB="1024M"
MEM_NOCODB="1024M"
MEM_MINIO="1024M"
MEM_TEMPORAL="768M"
MEM_WAF="256M"
MEM_REDIS="256M"
MEM_POOLER="256M"

# Matriz Dinâmica de Memória Reservada (Reservations)
